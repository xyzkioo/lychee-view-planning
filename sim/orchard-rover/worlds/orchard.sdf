<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="orchard">
    <physics name="physics" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.75 0.83 0.92 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.8</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="ground">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.38 0.42 0.30 1</ambient>
            <diffuse>0.38 0.42 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://lychee_tree</uri>
    </include>
    <include>
      <uri>model://orchard_rover</uri>
      <pose>4 0 0.01 0 0 3.14159265</pose>
    </include>
    <model name="overview_camera">
      <static>true</static>
      <pose>6 -8 5 0 0.40 2.13</pose>
      <link name="camera">
        <sensor name="overview" type="camera">
          <always_on>true</always_on>
          <update_rate>1</update_rate>
          <topic>/orchard/overview</topic>
          <camera>
            <horizontal_fov>1.05</horizontal_fov>
            <image>
              <width>800</width>
              <height>600</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>.05</near>
              <far>50</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>